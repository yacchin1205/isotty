#!/usr/bin/env python3
"""A gcloud for the end-to-end tests: the host side of isotty runs unchanged
and the VM is an sshd container.

Instances live as JSON files under $ISOTTY_FAKE_GCLOUD_STATE. `compute ssh`
goes to $ISOTTY_FAKE_VM_HOST:$ISOTTY_FAKE_VM_PORT as $ISOTTY_FAKE_VM_USER
with $ISOTTY_FAKE_VM_KEY, and `compute config-ssh` writes the same into the
ssh config isotty asks for. Any other invocation fails, so a call the fake
does not model shows up in the test instead of passing by accident.
"""
import json
import os
import re
import subprocess
import sys


def state_dir():
    path = os.environ.get('ISOTTY_FAKE_GCLOUD_STATE')
    if not path:
        fail('ISOTTY_FAKE_GCLOUD_STATE is not set')
    os.makedirs(os.path.join(path, 'instances'), exist_ok=True)
    return path


def fail(message, code=1):
    print('ERROR: (fake-gcloud) ' + message, file=sys.stderr)
    sys.exit(code)


def instance_path(name):
    return os.path.join(state_dir(), 'instances', name + '.json')


def load_instance(name, command):
    try:
        with open(instance_path(name), encoding='utf-8') as f:
            return json.load(f)
    except FileNotFoundError:
        # Spelled like gcloud: isotty looks for "was not found" and exit 1.
        print(f"ERROR: (gcloud.compute.instances.{command}) Could not fetch resource:\n - The resource '{name}' was not found", file=sys.stderr)
        sys.exit(1)


def save_instance(instance):
    with open(instance_path(instance['name']), 'w', encoding='utf-8') as f:
        json.dump(instance, f)


def list_instances():
    directory = os.path.join(state_dir(), 'instances')
    return [json.load(open(os.path.join(directory, p), encoding='utf-8')) for p in sorted(os.listdir(directory)) if p.endswith('.json')]


def parse(args):
    """Positional arguments and --flag=value / --flag value options."""
    positional, options = [], {}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg.startswith('--'):
            if '=' in arg:
                key, value = arg[2:].split('=', 1)
            elif i + 1 < len(args) and not args[i + 1].startswith('--'):
                key, value = arg[2:], args[i + 1]
                i += 1
            else:
                key, value = arg[2:], True
            options[key] = value
        else:
            positional.append(arg)
        i += 1
    return positional, options


def pairs(value):
    return dict(item.split('=', 1) for item in value.split(',')) if value else {}


def field(instance, name):
    if name == 'name':
        return instance['name']
    if name == 'status':
        return instance['status']
    if name == 'zone.basename()':
        return instance['zone']
    if name == 'machineType.basename()':
        return instance['machine_type']
    if name.startswith('labels.'):
        return instance['labels'].get(name[len('labels.'):], '')
    if name == 'networkInterfaces[0].networkIP':
        return '10.0.0.2'
    if name == 'networkInterfaces[0].accessConfigs[0].natIP':
        return ''
    fail('unsupported field ' + name)


def matches(instance, filter_expr):
    if not filter_expr:
        return True
    m = re.fullmatch(r'labels\.([a-z_]+)=(.+)', filter_expr)
    if not m:
        fail('unsupported filter ' + filter_expr)
    return instance['labels'].get(m.group(1)) == m.group(2)


def format_fields(fmt):
    m = re.fullmatch(r'(value|get)\((.*)\)', fmt)
    if not m:
        fail('unsupported format ' + fmt)
    return m.group(2).split(',')


def ssh_base():
    for key in ('ISOTTY_FAKE_VM_HOST', 'ISOTTY_FAKE_VM_PORT', 'ISOTTY_FAKE_VM_USER', 'ISOTTY_FAKE_VM_KEY'):
        if not os.environ.get(key):
            fail(key + ' is not set')
    return (
        os.environ['ISOTTY_FAKE_VM_HOST'], os.environ['ISOTTY_FAKE_VM_PORT'],
        os.environ['ISOTTY_FAKE_VM_USER'], os.environ['ISOTTY_FAKE_VM_KEY'],
    )


def compute_instances(args):
    positional, options = parse(args)
    command = positional[0]
    if command == 'list':
        fields = format_fields(options['format'])
        for instance in list_instances():
            if matches(instance, options.get('filter')):
                print('\t'.join(field(instance, f) for f in fields))
        return
    name = positional[1]
    if command == 'create':
        if os.path.exists(instance_path(name)):
            fail(f"instance {name} already exists")
        save_instance({
            'name': name, 'project': options['project'], 'zone': options['zone'], 'status': 'RUNNING',
            'machine_type': options.get('machine-type', ''), 'labels': pairs(options.get('labels', '')),
            'metadata': pairs(options.get('metadata', '')),
        })
        return
    instance = load_instance(name, command)
    if command == 'describe':
        fields = format_fields(options['format'])
        values = []
        for f in fields:
            if f.startswith('metadata.items.'):
                values.append(instance['metadata'].get(f[len('metadata.items.'):], ''))
            else:
                values.append(field(instance, f))
        print('\t'.join(values))
    elif command == 'stop':
        instance['status'] = 'TERMINATED'
        save_instance(instance)
    elif command == 'start':
        instance['status'] = 'RUNNING'
        save_instance(instance)
    elif command == 'delete':
        os.remove(instance_path(name))
    else:
        fail('unsupported instances command ' + command)


def compute_ssh(args):
    positional, options = parse(args)
    target = positional[0]
    name = target.split('@', 1)[-1]
    instance = load_instance(name, 'ssh')
    if instance['status'] != 'RUNNING':
        fail(f"instance {name} is {instance['status']}; ssh would not answer", 255)
    host, port, user, key = ssh_base()
    command = [
        'ssh', '-p', port, '-i', key,
        '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10',
        '-o', 'StrictHostKeyChecking=no', '-o', 'UserKnownHostsFile=/dev/null', '-o', 'LogLevel=ERROR',
        f'{user}@{host}',
    ]
    if 'command' in options:
        command.append(options['command'])
    sys.exit(subprocess.call(command))


def compute_config_ssh(args):
    _, options = parse(args)
    host, port, user, key = ssh_base()
    lines = []
    for instance in list_instances():
        lines += [
            f"Host {instance['name']}.{instance['zone']}.{instance['project']}",
            f"    HostName {host}", f"    Port {port}", f"    User {user}", f"    IdentityFile {key}",
            '    IdentitiesOnly yes', '    StrictHostKeyChecking no', '    UserKnownHostsFile /dev/null', '    LogLevel ERROR', '',
        ]
    with open(options['ssh-config-file'], 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))


def main():
    args = sys.argv[1:]
    with open(os.path.join(state_dir(), 'calls.log'), 'a', encoding='utf-8') as f:
        f.write(' '.join(args) + '\n')
    if args[:2] == ['compute', 'instances']:
        compute_instances(args[2:])
    elif args[:2] == ['compute', 'ssh']:
        compute_ssh(args[2:])
    elif args[:2] == ['compute', 'config-ssh']:
        compute_config_ssh(args[2:])
    elif args[:3] == ['compute', 'firewall-rules', 'list']:
        pass
    elif args[:3] == ['config', 'get-value', 'project']:
        print(os.environ.get('ISOTTY_GCP_PROJECT', '(unset)'))
    elif args[:3] == ['config', 'get-value', 'compute/zone']:
        print(os.environ.get('ISOTTY_GCP_ZONE', '(unset)'))
    else:
        fail('unsupported invocation: ' + ' '.join(args), 2)


if __name__ == '__main__':
    main()
